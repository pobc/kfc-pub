APP_ENV=development
# 仅当服务运行在这台机器上且不是 production/test 环境时，后台页面和接口免登录。
LOCAL_ADMIN_HOSTNAME=
HOST=0.0.0.0
PORT=3000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://kfc:change-me@localhost:5432/kfc
# 后台账号从 PostgreSQL users 表读取，不使用环境变量账号密码。
ADMIN_WEB_MD5=change-me-admin-path
PUBLIC_WEB_URL=http://localhost:3000
# 全局无效 access link 访问超过该值后，所有公网 access link 请求先做人机验证。
INVALID_ACCESS_LINK_THRESHOLD=200
# 人机验证通过后当前 IP 的有效分钟数。
PUBLIC_VERIFICATION_TTL_MINUTES=30
# 可选。多 worker/多实例部署时必须配置为相同的随机长字符串；留空时使用当前进程随机密钥。
PUBLIC_VERIFICATION_SECRET=

# 肯德基真实 H5 接口。
KFC_H5_BASE_URL=https://order.kfc.com.cn
KFC_REQUEST_TIMEOUT_MS=30000
KFC_CONFIG_CACHE_MS=600000

# 签名配置默认从当前 H5 首页及 App JS 动态提取；只有动态提取失效时才手工填写。
KFC_CLIENT_VERSION=
KFC_FVERSION=
KFC_KBS_KEY=
KFC_KBS_SECRET=
KFC_ROUTE_CELL=
KFC_USER_AGENT=
KFC_COOKIE_HEADER=
KFC_OPEN_ID=

# KFC Session 长期登录态保存在 PostgreSQL kfc_tickets 表。
# 后台“登录 KFC 并获取登录信息”由 Python FastAPI 启动 Chrome 并通过 CDP 抓取。
KFC_CHROME_PATH=
KFC_CHROME_PROFILE_DIR=
KFC_LOGIN_URL=

# 淘宝商品价格采集。先在后台打开独立登录窗口并保存登录信息，再执行抓取。
TAOBAO_SEARCH_URL=https://s.taobao.com/search?q=%E8%82%AF%E5%BE%B7%E5%9F%BA%E4%BB%A3%E4%B8%8B%E5%8D%95&page=1
# 淘宝登录与抓取任务的临时浏览器资料目录根路径；每次任务使用独立子目录并在结束后清理
TAOBAO_BROWSER_PROFILE_DIR=.kfc/taobao-price-browser
TAOBAO_BROWSER_EXECUTABLE_PATH=
TAOBAO_BROWSER_HEADLESS=false
TAOBAO_SCRAPE_MAX_PRODUCTS=60
TAOBAO_PAGE_TIMEOUT_MS=60000
TAOBAO_LOGIN_TIMEOUT_SECONDS=300
TAOBAO_LOGIN_CAPTURE_TTL_SECONDS=900

# 官网当前账号卡包接口。
KFC_COUPON_BASE_URL=https://appcoupon.kfc.com.cn/api
KFC_COUPON_AVAILABLE_API=/crm/queryAvailableCoupon
KFC_COUPON_HISTORY_API=/crm/queryCouponByUserCode
KFC_COUPON_AVAILABLE_QUERY_JSON={}
KFC_COUPON_HISTORY_QUERY_JSON={}

# 真实订单状态映射。
KFC_STATUS_MAP_JSON={}
KFC_QUEUE_NUMBER_FIELDS=
KFC_PICKUP_CODE_FIELDS=
